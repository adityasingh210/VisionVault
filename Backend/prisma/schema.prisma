generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//  Enums

enum ImageSource {
  LOCAL
  GOOGLE_PHOTOS
}

enum ImageProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DuplicateType {
  EXACT
  NEAR
}

enum JobType {
  HASH
  EMBEDDING
  OCR
  FACE
  CATEGORY
  CLUSTER
  EVENT
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum EventJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// Models 

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  googleAccount   GoogleAccount?
  images          Image[]
  duplicateGroups DuplicateGroup[]
  faceClusters    FaceCluster[]
  eventJobs       EventJob[]
  events          Event[]

  @@map("users")
}

model GoogleAccount {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  googleId     String   @unique @map("google_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  tokenExpiry  DateTime @map("token_expiry")
  connectedAt  DateTime @default(now()) @map("connected_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_accounts")
}

model Image {
  id String @id @default(uuid())

  userId String @map("user_id")

  filename String

  cloudinaryId  String @map("cloudinary_id")
  cloudinaryUrl String @map("cloudinary_url")

  // small preview of image, thumbnail can be generated using cloudinaryUrl

  width  Int?
  height Int?

  fileSize BigInt? @map("file_size")
  mimeType String? @map("mime_type")

  sha256Hash String? @map("sha256_hash")
  phash      String?

  source ImageSource @default(LOCAL)

  googlePhotosId String? @map("google_photos_id")

  takenAt DateTime? @map("taken_at")

  locationLat Decimal? @map("location_lat") @db.Decimal(9, 6)
  locationLng Decimal? @map("location_lng") @db.Decimal(9, 6)

  metadata Json?

  processingStatus ImageProcessingStatus @default(PENDING) @map("processing_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Optional soft delete
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageCategories ImageCategory[]

  duplicateMembers DuplicateGroupMember[]

  representativeFor DuplicateGroup[] @relation("RepresentativeImage")

  faces Face[]

  ocrRecord OcrRecord?

  processingJobs ProcessingJob[]

  eventImages    EventImage[]
  coverForEvents Event[]      @relation("EventCoverImage")

  @@unique([userId, cloudinaryId])
  @@index([userId])
  @@index([sha256Hash])
  @@index([phash])
  @@index([processingStatus])
  @@index([userId, processingStatus])
  @@index([source])
  @@index([takenAt(sort: Desc)])
  @@map("images")
}

model Category {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  label String

  imageCategories ImageCategory[]

  @@map("categories")
}

model ImageCategory {
  imageId    String   @map("image_id")
  categoryId Int      @map("category_id")
  confidence Decimal? @db.Decimal(4, 3)

  image    Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@id([imageId, categoryId])
  @@index([categoryId])
  @@map("image_categories")
}

model DuplicateGroup {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  type                  DuplicateType
  representativeImageId String?       @map("representative_image_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  representativeImage Image?                 @relation("RepresentativeImage", fields: [representativeImageId], references: [id], onDelete: SetNull)
  members             DuplicateGroupMember[]

  @@index([userId])
  @@map("duplicate_groups")
}

model DuplicateGroupMember {
  groupId String @map("group_id")
  imageId String @map("image_id")

  group DuplicateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  image Image          @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([groupId, imageId])
  @@map("duplicate_group_members")
  @@index([imageId])
}

model FaceCluster {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  label       String?
  coverFaceId String?  @map("cover_face_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  faces Face[]

  @@index([userId])
  @@map("face_clusters")
}

model Face {
  id             String       @id @default(uuid())
  imageId        String       @map("image_id")
  clusterId      String?      @map("cluster_id")
  bboxX          Float        @map("bbox_x")
  bboxY          Float        @map("bbox_y")
  bboxW          Float        @map("bbox_w")
  bboxH          Float        @map("bbox_h")
  detectionScore Decimal?     @map("detection_score") @db.Decimal(4, 3)
  embeddingId    String?      @map("embedding_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  qdrantId       String       @unique @map("qdrant_id")
  image          Image        @relation(fields: [imageId], references: [id], onDelete: Cascade)
  cluster        FaceCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([imageId])
  @@index([clusterId])
  @@map("faces")
}

model OcrRecord {
  id         String   @id @default(uuid())
  imageId    String   @unique @map("image_id")
  rawText    String   @map("raw_text")
  language   String?
  confidence Decimal? @db.Decimal(4, 3)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@map("ocr_records")
}

model ProcessingJob {
  id          String    @id @default(uuid())
  imageId     String    @map("image_id")
  jobType     JobType   @map("job_type")
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  error       String?
  queuedAt    DateTime  @default(now()) @map("queued_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([imageId, jobType])
  @@index([imageId])
  @@index([status, jobType])
  @@map("processing_jobs")
}

model EventJob {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  status      EventJobStatus @default(QUEUED)
  error       String?
  imageCount  Int?           @map("image_count")
  eventCount  Int?           @map("event_count")
  queuedAt    DateTime       @default(now()) @map("queued_at")
  startedAt   DateTime?      @map("started_at")
  completedAt DateTime?      @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("event_jobs")
}

model Event {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  title        String
  coverImageId String?   @map("cover_image_id")
  startAt      DateTime? @map("start_at")
  endAt        DateTime? @map("end_at")
  locationLat  Decimal?  @map("location_lat") @db.Decimal(9, 6)
  locationLng  Decimal?  @map("location_lng") @db.Decimal(9, 6)
  metadata     Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverImage  Image?       @relation("EventCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  eventImages EventImage[]

  @@index([userId])
  @@index([userId, startAt])
  @@map("events")
}

model EventImage {
  eventId String @map("event_id")
  imageId String @map("image_id")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([eventId, imageId])
  @@index([imageId])
  @@map("event_images")
}
